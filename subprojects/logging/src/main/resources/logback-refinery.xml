<included>
    <conversionRule conversionWord="pinoLevel"
                    class="tools.refinery.logging.PinoLevelConverter"/>
    <conversionRule conversionWord="throwableType"
                    class="tools.refinery.logging.ThrowableTypeConverter"/>
    <conversionRule conversionWord="throwableMessage"
                    class="tools.refinery.logging.ThrowableMessageConverter"/>
    <conversionRule conversionWord="stack"
                    class="net.logstash.logback.stacktrace.ShortenedThrowableConverter"/>
    <define name="PID" class="tools.refinery.logging.PidPropertyDefiner"/>
    <appender name="refinery-console"
              class="ch.qos.logback.core.ConsoleAppender">
        <condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
            <key>REFINERY_LOG_DESTINATION</key>
            <value>stdout</value>
        </condition>
        <if>
            <then>
                <target>System.out</target>
            </then>
            <else>
                <target>System.err</target>
            </else>
        </if>
        <condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
            <key>REFINERY_LOG_FORMAT</key>
            <value>json</value>
        </condition>
        <if>
            <then>
                <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                    <providers>
                        <timestamp>
                            <fieldName>time</fieldName>
                            <pattern>[UNIX_TIMESTAMP_AS_NUMBER]</pattern>
                        </timestamp>
                        <mdc>
                            <excludeMdcKeyName>err</excludeMdcKeyName>
                            <excludeMdcKeyName>hostname</excludeMdcKeyName>
                            <excludeMdcKeyName>level</excludeMdcKeyName>
                            <excludeMdcKeyName>msg</excludeMdcKeyName>
                            <excludeMdcKeyName>name</excludeMdcKeyName>
                            <excludeMdcKeyName>pid</excludeMdcKeyName>
                            <excludeMdcKeyName>thread</excludeMdcKeyName>
                            <excludeMdcKeyName>time</excludeMdcKeyName>
                        </mdc>
                        <pattern>
                            <omitEmptyFields>true</omitEmptyFields>
                            <pattern>
                                {
                                    "level": "#asLong{%pinoLevel}",
                                    "hostname": "${HOSTNAME}",
                                    "pid": "#asLong{${PID}}",
                                    "thread": "%thread",
                                    "name": "%logger",
                                    "msg": "%message",
                                    "err": {
                                        "type": "%throwableType",
                                        "message": "%throwableMessage",
                                        "stack": "%stack{20,full,2048,rootFirst,omitCommonFrames,^jdk\\.internal\\..*}"
                                    }
                                }
                            </pattern>
                        </pattern>
                    </providers>
                </encoder>
            </then>
            <else>
                <encoder>
                    <pattern>
                        %d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
                    </pattern>
                </encoder>
            </else>
        </if>
    </appender>
</included>
